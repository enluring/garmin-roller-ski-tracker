<!--
    skiType is set on-watch via the picker shown at the start of a session
    (see SkiTypePickerDelegate.mc), not from a phone settings screen. It's
    declared here so Application.Properties.setValue()/getValue() has a
    typed, defaulted backing store. 0 = classic, 1 = skate, 2 = double
    poling (see the SkiType module in RollerSkiTrackerApp.mc).

    thresholdClassic / thresholdSkate / thresholdDoublePoling and
    axisClassic / axisSkate / axisDoublePoling are UNVALIDATED placeholder
    starting points for StrokeDetector's peak detection, not measured
    values - see StrokeDetector.mc. They ARE editable from the Connect IQ
    phone app (resources/settings/settings.xml) so they can be recalibrated
    from field data without rebuilding. Axis: 0 = X, 1 = Y, 2 = Z.
-->
<properties>
    <property id="skiType" type="number">0</property>

    <property id="thresholdClassic" type="number">1200</property>
    <property id="thresholdSkate" type="number">1000</property>
    <property id="thresholdDoublePoling" type="number">1400</property>

    <property id="axisClassic" type="number">2</property>
    <property id="axisSkate" type="number">1</property>
    <property id="axisDoublePoling" type="number">2</property>
</properties>
