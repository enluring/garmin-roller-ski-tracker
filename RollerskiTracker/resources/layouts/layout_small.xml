<!--
    Compact layout: used when the field is given a small drawing area, e.g.
    placed in a 2/3/4-field data screen. Drops the "STROKE RATE" caption to
    save vertical space and uses smaller fonts. Selected at runtime in
    RollerskiView.onLayout() based on the field's actual dc height.
-->
<layout id="MainLayoutSmall">
    <label id="RateValue" x="dc.getWidth() / 2" y="dc.getHeight() * 0.34" font="Graphics.FONT_NUMBER_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE">--</label>
    <label id="DistanceValue" x="dc.getWidth() * 0.27" y="dc.getHeight() * 0.8" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE">--</label>
    <label id="DistPerStrokeValue" x="dc.getWidth() * 0.73" y="dc.getHeight() * 0.8" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" color="Graphics.COLOR_WHITE">--</label>
</layout>
