    from the Visual Studio Code command palette instead of hand-editing it.
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application
        entry="RollerskiApp"
        id="652396E53FFD476C8C80A29F775E0DCD"
        minSdkVersion="3.2.0"
        name="@Strings.AppName"
        type="datafield">
        <iq:products>
            <iq:product id="fenix7"/>
            <iq:product id="fr965"/>
            <iq:product id="fr265"/>
        </iq:products>
        <iq:permissions>
            <!-- Accelerometer sampling for stroke (pole-plant) detection. -->
            <iq:uses-permission id="Sensor"/>
            <!-- Custom FIT fields (stroke rate, lap stroke count, distance/stroke). -->
            <iq:uses-permission id="FitContributor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
